# Copy to .env and fill in. Never commit .env.
GOOGLE_GENAI_USE_VERTEXAI=1
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# Gemini model ID. Check Vertex AI Model Garden for the newest Flash-class model and set it here
# (verify with ./check_model.sh). As of Sep 2026 that is gemini-3.8-flash (GA, released 2026-09-02).
MODEL=gemini-3.8-flash
# Endpoint the model is served from. Current Gemini models are on `global` (or the `us` / `eu` multi-regions),
# not on single regions like us-central1. This is independent of GOOGLE_CLOUD_LOCATION (Agent Engine / Cloud Run region).
MODEL_LOCATION=global

# Parallel Search API key from https://platform.parallel.ai
PARALLEL_API_KEY=your-parallel-api-key

# Set after `./deploy_agent_engine.sh`; the web UI calls this Agent Engine resource.
# Leave blank to run the ADK agent in-process (local development).
AGENT_ENGINE_ID=

# Optional tuning
CLEARCUT_MAX_ENTITIES=120
CLEARCUT_MAX_RESULTS=5
CLEARCUT_MAX_WORKERS=8
CLEARCUT_SEARCH_MODE=fast
