# Copy to .env and fill in. Never commit .env.

# --- Gemini access: pick ONE of the three modes -------------------------------------------------
# (a) Vertex AI with a billed project (production; required for Agent Engine / Cloud Run deploys)
GOOGLE_GENAI_USE_VERTEXAI=1
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=us-central1
# (b) Vertex AI Express Mode: set GOOGLE_GENAI_USE_VERTEXAI=1, leave GOOGLE_CLOUD_PROJECT empty, set GOOGLE_API_KEY
# (c) Gemini Developer API (AI Studio key, free tier): set GOOGLE_GENAI_USE_VERTEXAI=0 and GOOGLE_API_KEY
GOOGLE_API_KEY=

# Gemini model ID. Check Vertex AI Model Garden for the newest Flash-class model and set it here
# (verify with ./check_model.sh). As of Sep 2026 that is gemini-3.8-flash (GA, released 2026-09-02).
MODEL=gemini-3.8-flash
# Endpoint the model is served from. Current Gemini models are on `global` (or the `us` / `eu` multi-regions),
# not on single regions like us-central1. This is independent of GOOGLE_CLOUD_LOCATION (Agent Engine / Cloud Run region).
MODEL_LOCATION=global
# Optional: model used for the rest of a run if MODEL's quota is exhausted (HTTP 429). Free-tier daily quotas on the
# newest model are small (20 requests/day at the time of writing), so a fallback keeps demos alive.
MODEL_FALLBACK=gemini-3.5-flash

# Parallel Search API key from https://platform.parallel.ai
PARALLEL_API_KEY=your-parallel-api-key

# Set after `./deploy_agent_engine.sh`; the web UI calls this Agent Engine resource.
# Leave blank to run the ADK agent in-process (local development).
AGENT_ENGINE_ID=

# Optional tuning
CLEARCUT_MAX_ENTITIES=120
CLEARCUT_MAX_RESULTS=5
CLEARCUT_MAX_WORKERS=8
CLEARCUT_SEARCH_MODE=fast
